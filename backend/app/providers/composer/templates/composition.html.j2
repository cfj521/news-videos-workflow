<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #000; overflow: hidden; }
    .scene { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
    .scene img { width: 100%; height: 100%; object-fit: cover; }
    .subtitle {
      position: absolute; bottom: {{ subtitle_bottom_px | default(80) }}px; left: 50%; transform: translateX(-50%);
      font-size: {{ subtitle_font_size | default(48) }}px; color: white; text-align: center; max-width: 80%;
      text-shadow: 2px 2px 6px rgba(0,0,0,0.9), 0 0 20px rgba(0,0,0,0.5);
      font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
      line-height: 1.4;
      opacity: 0;
    }
    .group-title {
      position: absolute; top: {{ title_margin_px }}px;
      right: {{ title_margin_px }}px;
      font-size: {{ title_font_size | default(48) }}px; color: {{ overlay.color | default('white') }};
      background: rgba(0,0,0,{{ overlay.bg_opacity | default(0.45) }});
      padding: 8px 16px; border-radius: 12px; max-width: 60%;
      font-family: "Microsoft YaHei", "PingFang SC", sans-serif; opacity: 0;
    }
    .cover .cover-overlay {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 0.4em; text-align: center; padding: 8%;
      background: rgba(0,0,0,0.28);
    }
    .cover-title {
      color: #fff; font-weight: 800; line-height: 1.25;
      text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
      font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    }
    .cover-subtitle {
      color: #eee; line-height: 1.4;
      text-shadow: 1px 1px 6px rgba(0,0,0,0.8);
      font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    }
  </style>
</head>
<body>
  <div id="main"
       data-composition-id="main"
       data-width="{{ width }}"
       data-height="{{ height }}"
       data-start="0"
       data-duration="{{ total_duration_s }}">

    {% for entry in entries %}
    {% if entry.is_cover %}
    <div class="scene clip cover" id="s{{ entry.scene_id }}"
         data-start="{{ entry.start_s }}"
         data-duration="{{ entry.duration_s }}"
         data-track-index="0"
         {% if not loop.first %}style="visibility:hidden;opacity:0;"{% endif %}>
      {% if entry.image_path %}<img src="{{ entry.image_path }}" alt="cover">{% endif %}
      <div class="cover-overlay">
        <div class="cover-title" style="font-size:{{ entry.cover_font_size | default(72) }}px; color:{{ entry.cover_text_color | default('#FFFFFF') }};">{{ entry.title }}</div>
        {% if entry.subtitle %}<div class="cover-subtitle" style="font-size:{{ (entry.cover_font_size | default(72) * 0.55) | round | int }}px; color:{{ entry.cover_text_color | default('#FFFFFF') }};">{{ entry.subtitle }}</div>{% endif %}
      </div>
    </div>
    {% else %}
    <div class="scene clip" id="s{{ entry.scene_id }}"
         data-start="{{ entry.start_s }}"
         data-duration="{{ entry.duration_s }}"
         data-track-index="0"
         {% if not loop.first %}style="visibility:hidden;opacity:0;"{% endif %}>
      <div class="scene-content">
        <img src="{{ entry.image_path }}" alt="scene {{ entry.scene_id }}">
      </div>
    </div>
    {% endif %}
    {% endfor %}

    {# Per-line subtitle elements #}
    {% for entry in entries %}
    {% for line in entry.subtitle_lines %}
    <div class="subtitle" id="sub{{ entry.scene_id }}_{{ loop.index0 }}">{{ line.text }}</div>
    {% endfor %}
    {% endfor %}

    {% for ov in title_overlays %}
    <div class="group-title" id="gt{{ loop.index0 }}">{{ ov.title }}</div>
    {% endfor %}

    {% for entry in entries %}
    {% if entry.audio_path %}
    <audio id="narration-{{ entry.scene_id }}"
           data-start="{{ entry.start_s }}"
           data-duration="{{ entry.audio_duration_s }}"
           data-track-index="1"
           data-volume="1.0"
           src="{{ entry.audio_path }}"></audio>
    {% endif %}
    {% endfor %}
  </div>

  <script>
    const tl = gsap.timeline();

    {% for entry in entries %}
    {% if not loop.first %}
    {# Scene transition #}
    {% if transition == 'crossfade' %}
    tl.to("#s{{ prev_scene_ids[loop.index0] }}", { autoAlpha: 0, duration: 0.6, ease: "power2.inOut" }, {{ entry.start_s }});
    tl.to("#s{{ entry.scene_id }}", { autoAlpha: 1, duration: 0.6, ease: "power2.inOut" }, {{ entry.start_s }});
    {% elif transition == 'slide' %}
    tl.set("#s{{ entry.scene_id }}", { autoAlpha: 1, xPercent: 100 }, {{ entry.start_s }});
    tl.to("#s{{ entry.scene_id }}", { xPercent: 0, duration: 0.5, ease: "power2.out" }, {{ entry.start_s }});
    tl.to("#s{{ prev_scene_ids[loop.index0] }}", { xPercent: -100, duration: 0.5, ease: "power2.out" }, {{ entry.start_s }});
    {% elif transition == 'fade' %}
    tl.to("#s{{ prev_scene_ids[loop.index0] }}", { autoAlpha: 0, duration: 0.3 }, {{ entry.start_s }});
    tl.set("#s{{ entry.scene_id }}", { autoAlpha: 1 }, {{ entry.start_s + 0.3 }});
    {% else %}
    tl.set("#s{{ entry.scene_id }}", { autoAlpha: 1 }, {{ entry.start_s }});
    tl.set("#s{{ prev_scene_ids[loop.index0] }}", { autoAlpha: 0 }, {{ entry.start_s }});
    {% endif %}
    {% endif %}

    {# Ken Burns effect on image #}
    tl.from("#s{{ entry.scene_id }} img", {
      scale: 1.08, duration: {{ entry.duration_s }}, ease: "sine.inOut"
    }, {{ entry.start_s }});

    {# Per-line subtitles #}
    {% for line in entry.subtitle_lines %}
    tl.to("#sub{{ entry.scene_id }}_{{ loop.index0 }}", {
      opacity: 1, y: 0, duration: 0.3, ease: "power2.out"
    }, {{ entry.start_s + line.start_s }});
    tl.fromTo("#sub{{ entry.scene_id }}_{{ loop.index0 }}", { y: 10 }, {
      y: 0, duration: 0.3
    }, {{ entry.start_s + line.start_s }});
    tl.to("#sub{{ entry.scene_id }}_{{ loop.index0 }}", {
      opacity: 0, duration: 0.2
    }, {{ entry.start_s + line.end_s - 0.2 }});
    {% endfor %}
    {% endfor %}

    {% for ov in title_overlays %}
    tl.to("#gt{{ loop.index0 }}", { opacity: 1, duration: 0.3 }, {{ ov.start_s }});
    tl.to("#gt{{ loop.index0 }}", { opacity: 0, duration: 0.3 }, {{ ov.end_s - 0.3 if ov.end_s > 0.3 else ov.end_s }});
    {% endfor %}

    window.__timelines = { main: tl };

    // 渲染成片不烧字幕（字幕走外挂 SRT，便于各平台开关/编辑）；仅预览(iframe)显示字幕供审核。
    if (window.self === window.top) {
      document.querySelectorAll('.subtitle').forEach(function (el) { el.style.display = 'none'; });
    }

    // 各分镜旁白的时间区间，用于按时间轴驱动音频播放（预览用；导出由 hyperframes 按 data-* 合成）
    var audioEntries = [
      {% for entry in entries %}{% if entry.audio_path %}{ id: "narration-{{ entry.scene_id }}", start: {{ entry.start_s }}, dur: {{ entry.audio_duration_s }} },
      {% endif %}{% endfor %}
    ];
    var activeAudioId = null;
    function syncAudio() {
      if (tl.paused()) {
        document.querySelectorAll('audio').forEach(function(a){ if (!a.paused) a.pause(); });
        return;
      }
      var t = tl.time(), cur = null;
      for (var i = 0; i < audioEntries.length; i++) {
        var e = audioEntries[i];
        if (e.dur > 0 && t >= e.start && t < e.start + e.dur) { cur = e; break; }
      }
      if (cur && cur.id === activeAudioId) return;  // 同一段播放中，不打断
      if (activeAudioId) { var prev = document.getElementById(activeAudioId); if (prev) prev.pause(); }
      activeAudioId = cur ? cur.id : null;
      if (cur) {
        var a = document.getElementById(cur.id);
        if (a) { try { a.currentTime = Math.max(0, t - cur.start); } catch (_) {} a.play().catch(function(){}); }
      }
    }

    // Preview mode: pause in iframe, respond to parent postMessage
    if (window.self !== window.top) {
      tl.pause();
      gsap.ticker.add(syncAudio);  // 预览时按时间轴同步音频播放
      setInterval(function() {
        window.parent.postMessage({
          type: 'progress',
          time: tl.time(),
          duration: tl.duration(),
          paused: tl.paused()
        }, '*');
      }, 250);
    }

    window.addEventListener('message', function(e) {
      if (!e.data || !e.data.type) return;
      var audios = document.querySelectorAll('audio');
      if (e.data.type === 'play') { tl.play(); }
      if (e.data.type === 'pause') { tl.pause(); audios.forEach(function(a){a.pause();}); activeAudioId = null; }  // 清掉 → 恢复播放时 syncAudio 重新对齐并 play 当前段（否则同段守卫会跳过，声音要等下一分镜才回来）
      if (e.data.type === 'restart') { audios.forEach(function(a){ a.pause(); try { a.currentTime = 0; } catch (_) {} }); activeAudioId = null; tl.restart(); }
      if (e.data.type === 'seek') { tl.seek(e.data.time); activeAudioId = null; }  // 重置 → 下一帧重新对齐音频
    });
  </script>
</body>
</html>
