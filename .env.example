DATABASE_URL=sqlite:///./data/news_videos.db
REDIS_URL=redis://localhost:6379/0

# --- Text Provider (脚本生成) ---
TEXT_PROVIDER=claude
TEXT_PROVIDER_BASE_URL=
TEXT_PROVIDER_MODEL=claude-sonnet-4-6
TEXT_PROVIDER_API_KEY=sk-ant-xxx

# --- Image Provider (图片素材生成) ---
IMAGE_PROVIDER=openai
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_MODEL=gpt-image-1
IMAGE_PROVIDER_API_KEY=sk-xxx

# --- TTS Provider (语音合成) ---
TTS_PROVIDER=edge-tts
TTS_PROVIDER_BASE_URL=
TTS_PROVIDER_API_KEY=
TTS_PROVIDER_MODEL=
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
TTS_DEFAULT_SPEED=1.0

# --- Collector (新闻采集源) ---
TAVILY_API_KEY=tvly-xxx
BRAVE_SEARCH_API_KEY=BSA-xxx
SERPER_API_KEY=xxx

# --- Publisher: YouTube ---
YOUTUBE_CLIENT_ID=xxx
YOUTUBE_CLIENT_SECRET=xxx

# --- Pipeline Defaults ---
DEFAULT_TIME_RANGE=7d
DEFAULT_MAX_ARTICLES=5
DEFAULT_VIDEO_ROUTE=hyperframes
DEFAULT_LANGUAGE=zh
