# 复制为 config.yaml（放在仓库根目录）后填入密钥即可运行（config.yaml 已被 .gitignore 忽略，不会入库）。
# 未列出的字段会用代码内置默认值；推荐通过前端「设置」页可视化配置，保存时会写回本文件。

# ---- 基础设施 ----
infra:
  database_url: sqlite:///../data/news_videos.db   # 单进程内置后台任务，SQLite 够用；高并发再换 PostgreSQL
  data_dir: ../data

# ---- 存储：work_dir 留空用默认 data/runs；output_dir 留空则不额外导出成品 ----
storage:
  work_dir: ""
  output_dir: ""

# ---- 供应商参数库：各供应商的连接凭证 + 参数（api_key 留空则该供应商不可用）----
#      「当前用哪个供应商 + 哪个模型」在下方 pipeline 段统一选择；这里只配参数。
#      max_output_tokens：文本/视觉模型单次输出上限；models：可用模型名（按类型分组，可在「模型配置」页增删）。
#      也支持自定义供应商：在此或「模型配置」页新增一个键即可。models 留空时启动会自动补内置默认。
providers:
  claude:
    base_url: https://api.anthropic.com
    api_key: ""
    max_output_tokens: 65535
    models:
      text: [claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5-20251001]
  openai:
    base_url: https://api.openai.com/v1
    api_key: ""
    auth_mode: api_key            # api_key（填 key 按量计费）| subscription（ChatGPT 订阅登录，在「模型配置」页登录）
    max_output_tokens: 65535
    models:
      text: [gpt-5.5, gpt-5.5-pro, gpt-5]
      image: [gpt-image-2, gpt-image-1.5, gpt-image-1]
      vision: [gpt-5.5, gpt-5, gpt-4o]
      tts: [gpt-4o-mini-tts, tts-1-hd, tts-1]
  dashscope:
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: ""
    max_output_tokens: 65535
    models:
      text: [qwen3.7-max, qwen3.6-plus, qwen3.6-flash]
      image: [qwen-image-2.0, qwen-image-2.0-pro, wan2.7-image, wan2.7-image-pro]
      vision: [qwen3.6-plus, qwen3.6-flash]
      tts: [qwen3-tts-flash, cosyvoice-v3-flash]   # 语音与文本/图片共用同一 dashscope key
  # 语音生成：openai/dashscope 复用上面的供应商（共用 key），edge-tts 为微软免费语音（无凭证）
  edge-tts:
    base_url: ""
    api_key: ""

# ---- 搜索类采集器 Key（按需；启用对应信息源时才需要）----
collectors:
  tavily_key: ""
  brave_key: ""
  serper_key: ""

# ---- YouTube OAuth（也可改在「发布管理」页按平台配置，存 DB）----
youtube:
  client_id: ""
  client_secret: ""

# ---- 流水线默认参数 + 当前选型（创建任务窗口与 run 从这里读默认）----
pipeline:
  default_time_range: 7d                # 1d | 3d | 7d | 15d | 1m
  default_max_articles: 5
  default_video_route: comfyui          # comfyui | hyperframes | audio
  default_language: zh                  # zh | en
  dedup_lookback: 30d
  resolution: 1080x1920                 # 默认图片/视频分辨率
  max_images: 10                        # 单任务最多生成图片数（0=不限制）；超过则生图前 AI 重规划分镜合并短文章
  # 各用途选型：provider 对应上面 providers 的 key，model 为具体模型
  summary_provider: openai
  summary_model: gpt-5
  summary_max_length: 150
  script_provider: claude               # 文案/脚本生成
  script_model: claude-sonnet-4-6
  image_provider: comfyui               # comfyui | openai | dashscope
  image_model: z_image_turbo            # comfyui 时为图片 workflow：z_image_turbo | qwen_image
  vision_provider: openai               # 文档解析（导入 PDF）
  vision_model: gpt-4o
  tts_provider: edge-tts                # edge-tts(微软免费) | openai | dashscope（共用对应 key）
  tts_model: ""                         # edge-tts 无模型留空；openai/dashscope 选具体模型
  tts_voice: zh-CN-XiaoxiaoNeural
  video_model: wan2.2_5b                # comfyui 视频 workflow：wan2.2_5b | wan2.2_14b | wan2.2_14b_lightx2v | ltx_2.3
  video_fps: 24                         # comfyui 视频帧率

# ---- 视频输出 ----
# ---- Hyperframes 渲染配置（分辨率以任务级 run.resolution 为准，不在此处）----
video:
  fps: "30"
  scene_gap_ms: 500
  transition: crossfade                 # crossfade | fade | slide | cut
  subtitle_font_size: 48                 # 字幕字号（px，按渲染分辨率计）
  subtitle_max_lines: 2                  # 单条字幕最多行数，超长旁白据此自动切分

# ---- ComfyUI 参数库（image_provider 或 video_route 选 comfyui 时生效）----
#      当前用哪个图片/视频 workflow 由 pipeline.image_model / video_model 决定，这里只配参数。
comfyui:
  server_url: http://127.0.0.1:8188     # 图片与视频生成共用
  default_negative: 模糊, 丑陋, 变形, 低质量, 水印
  # 各 workflow 的 steps/cfg（image_params / video_params）建议在「设置 → ComfyUI 参数」页调整

# ---- 可编辑提示词：以下为中文默认（与 backend/app/prompts.py 同步）；可在「设置 → 提示词配置」页编辑，留空则回退内置默认 ----
#      中英两套：每个键再加 `<key>_en` 即为英文版（任务语言=en 时用）；留空则回退内置英文默认。
#      例如 roundup_article_en / daily_batch_en / summary_meta_en / weekly_digest_en / image_regen_en / article_summary_en / news_scoring_en。
prompts:
  roundup_article: |-
    你是新闻短视频的分镜脚本编写者。下面给你一条资讯，为它生成 1~3 个分镜（内容多/重要则多，简短则 1 个）。
    输出纯 JSON（无 markdown 标记）：
    {"scenes":[{"narration":"口语化中文旁白","image_prompt":"English scene description","motion_prompt":"English camera motion","duration_hint":5}]}
    要求：
    - narration：像新闻主播口播的通俗中文，简单易懂，少用生僻词和英文。
    - image_prompt / motion_prompt：用英文（English only）；画面人物必须是亚洲/中国人面孔（East Asian / Chinese faces），场景与背景为中式真实环境，避免出现欧美面孔。
    - 分镜数不超过 3。
  daily_batch: |-
    你是 AI 资讯日报短视频的分镜脚本编写者。下面给你同一类目下的若干条资讯，请每条资讯生成 1 个分镜，顺序与给定一致。
    输出纯 JSON（无 markdown 标记）：
    {"scenes":[{"narration":"口语化中文旁白","image_prompt":"English scene description","motion_prompt":"English camera motion","duration_hint":5}]}
    要求：
    - narration：通俗易懂的中文口播，少用英文。
    - image_prompt / motion_prompt：用英文（English only）；人物为亚洲/中国人面孔（East Asian / Chinese faces）、中式场景背景，避免欧美面孔。
    - 分镜数量须等于给定资讯条数。
  summary_meta: |-
    你是短视频运营。下面给你一条汇总视频包含的各条资讯标题，生成整条视频的吸睛标题与简介。
    输出纯 JSON（无 markdown 标记）：{"title":"中文标题","description":"1-2句中文简介","tags":["标签1","标签2"]}
  weekly_digest: |-
    你是 AI 资讯周报编辑。下面给你过去一整周的全部资讯条目（含日期/分类线索）。
    请跨天归纳出**本周 3-5 个最重要的热点主题**，每个主题挑 1-3 条最有代表性的资讯，**全部主题的资讯总条数不超过 9 条**。
    要求：体现"本周"视角（趋势、归纳），合并跨天对同一事件的重复报道。
    输出纯 JSON（无 markdown 标记）：
    {"sections":[{"label":"主题名(中文)","items":[{"title":"资讯标题","summary":"一句话摘要"}]}]}
  image_regen: |-
    你是视频图片提示词专家。根据旁白文本生成一段详细的 AI 图片生成提示词，描述一张能配合旁白内容的画面。
    要求：用英文输出（English only）；画面人物必须是亚洲/中国人面孔（East Asian / Chinese），场景与背景为中式真实环境，避免欧美面孔。只输出提示词本身，不要其他内容。
  article_summary: |-
    用中文为新闻文章生成简洁摘要。只输出摘要文本。
  news_scoring: |-
    你是新闻评分专家。根据以下标准为新闻打分（0-10 整数）：

    评分标准：
    - 9-10：重大突破、范式转变、广泛使用的技术的重大版本发布
    - 7-8：有深度的技术文章、新颖方法、有洞见的分析
    - 5-6：增量改进、有用教程、中等社区兴趣
    - 3-4：小更新、常识内容、过度宣传
    - 0-2：垃圾、纯推广、离题、琐碎更新

    评分要考虑：
    - 技术深度和新颖性
    - 对领域的潜在影响
    - 写作/展示质量
    - 与 AI/ML、软件工程的相关性
    - 社区互动信号（高投票+有质量的讨论 = 社区验证的重要性）

    输出纯 JSON，不要 markdown 标记：
    {"score": <0-10整数>, "reason": "<一句话理由>", "tags": ["<标签1>", "<标签2>"]}
