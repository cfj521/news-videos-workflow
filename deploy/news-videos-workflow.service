# systemd 服务单元 —— 新闻视频自动化工作流（Ubuntu 裸机 / VM 部署）
#
# 一个进程同时托管：FastAPI 后端 + 进程内流水线（全局串行 worker）+ 前端静态产物。
# 流水线跑在进程内，无需独立 worker/broker。
#
# ┌─ 安装步骤（详见 deploy/README.md）────────────────────────────────────┐
# │ 1) 仓库部署到 /opt/news-videos-workflow（或改下方所有路径）            │
# │ 2) conda 环境 + 依赖：                                                 │
# │      conda create -n env_news_videos_wf python=3.12                    │
# │      conda run -n env_news_videos_wf pip install -r requirements.txt   │
# │ 3) 系统依赖： sudo apt install -y ffmpeg fonts-noto-cjk                 │
# │      （Hyperframes 视频路线另需 Node>=22 + sudo npm i -g hyperframes）  │
# │ 4) 构建前端： cd frontend && pnpm install && pnpm build                 │
# │ 5) cp config.yaml.example config.yaml 并填密钥                          │
# │ 6) 按本机改下方 User / 路径 / 端口，然后：                              │
# │      sudo cp deploy/news-videos-workflow.service /etc/systemd/system/  │
# │      sudo systemctl daemon-reload                                      │
# │      sudo systemctl enable --now news-videos-workflow                  │
# │ 7) 浏览器开 http://<host>:8190 （默认 admin / admin）                   │
# └───────────────────────────────────────────────────────────────────────┘
#   查看日志： journalctl -u news-videos-workflow -f

[Unit]
Description=News Videos Workflow (FastAPI backend + in-process pipeline + frontend)
Documentation=https://github.com/cfj521/news-videos-workflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── 改这里①：运行用户（非 root，需对仓库目录与 data/ 有读写权限）──
User=newsvideo
Group=newsvideo

# ── 改这里②：仓库根下的 backend 目录（uvicorn 的工作目录）──
WorkingDirectory=/opt/news-videos-workflow/backend

# 监听端口（后端单端口同时托管 API 与前端）
Environment=APP_PORT=8190
# 前端构建产物目录（缺省即仓库 frontend/dist，一般无需改）
Environment=FRONTEND_DIST=/opt/news-videos-workflow/frontend/dist
# ── 改这里③：PATH 需含 conda 环境(uvicorn/python) + 系统(ffmpeg/ffprobe/node/npx)──
Environment=PATH=/opt/miniconda3/envs/env_news_videos_wf/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 可选：ComfyUI 不在本机默认地址时，覆盖 config.yaml 的 comfyui.server_url
# Environment=NV_COMFYUI_URL=http://127.0.0.1:8188

# ── 改这里④：用 conda 环境里的 uvicorn 绝对路径启动 ──
ExecStart=/opt/miniconda3/envs/env_news_videos_wf/bin/uvicorn app.main:app --host 0.0.0.0 --port ${APP_PORT}

# 优雅停机：uvicorn 收 SIGINT 走 lifespan 清理（注意：进程内排队中的任务会随重启丢失）
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=5

# 轻量加固（如导致 data/ 或 config.yaml 写入失败，可注释这两行）
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
