# Docker Compose 变量（仅 compose 解析时插值；与应用读取的 config.yaml 互不影响）
# 用法：cp .env.example .env  然后按需修改。.env 已被 .gitignore 忽略。

# ---- 端口 ----
# 单容器一体化：浏览器入口 = API 入口 = APP_PORT（前后端同一端口）。
APP_PORT=8190           # 容器对外端口；浏览器打开 http://localhost:8190

# ---- 后端容器访问宿主机 ComfyUI 的地址 ----
# 容器内不能用 127.0.0.1（那指容器自身）；默认走 host.docker.internal 指向宿主机。
# 该值注入后端并覆盖 config.yaml 的 comfyui.server_url，无需手改 config.yaml。
COMFYUI_URL=http://host.docker.internal:8188
